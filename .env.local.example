# Clerk Auth
# Production keys (Vercel Production / resonate.corvolabs.com):
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dev keys (localhost + Vercel Preview — optional if you only use dev keys locally):
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY_DEV=
CLERK_SECRET_KEY_DEV=

# Preview sandbox seed (dev Convex only — see docs/preview-seed.md):
# npx convex run publishing:seedPreviewWorkspace '{"dryRun":false}' --identity '{"subject":"user_..."}'
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/setup

# Authenticated e2e (V4 — see docs/e2e-authenticated-sessions.md):
# The Playwright global-setup mints a Clerk dev-instance sign-in token
# (sk_test_/pk_test_ keys only — live-instance keys are refused) and stores a
# session storageState. Without these, the authenticated spec skips with the
# named reason instead of faking a pass.
E2E_CLERK_USER_ID=
# Optional: Backend API base URL (default https://api.clerk.com) and sign-in
# token lifetime in seconds (default 300, max 3600).
E2E_CLERK_API_BASE_URL=
E2E_CLERK_TOKEN_EXPIRES_IN_SECONDS=

# Comma-separated emails allowed to use the app. Enforced in proxy.ts.
# In production this FAILS CLOSED: if unset or empty, all authenticated
# requests are rejected. Outside production, empty means no restriction.
# (Replaces the never-implemented AUTHORIZED_EMAILS placeholder.)
RESONATE_ALLOWED_EMAILS=

# Set to 1 to allow deterministic mock AI responses without PIONEER_API_KEY.
# Local/test only — ignored when NODE_ENV or VERCEL_ENV is production.
RESONATE_ALLOW_MOCK_AI=

# Convex
# Production deployment (shared prod data): https://healthy-platypus-553.convex.cloud
# Dev deployment (local + Vercel Preview): run `npx convex dev` and paste the dev URL here.
# Use the SAME dev deployment URL for local `.env.local` and Vercel Preview env vars so
# branch previews and localhost share one sandbox. Production keeps its own URL.
# Pair dev Convex with Clerk *development* keys — production pk_live keys only work on
# resonate.corvolabs.com, not localhost or *.vercel.app.
NEXT_PUBLIC_CONVEX_URL=

# Corvo Cortex LLM Gateway
CORTEX_API_KEY=
CORTEX_BASE_URL=

# Resonate v2 / PioneerAI inference
# Store real keys only in local/Vercel secret scope. Do not commit them.
PIONEER_API_KEY=
PIONEER_DRAFT_MODEL=

# Z.AI vision alt-text generation
ZAI_API_KEY=
ZAI_ALT_MODEL=
ZAI_BASE_URL=

# GitHub Blog Publishing
GITHUB_TOKEN=
BLOG_REPO_OWNER=jakebutler
BLOG_REPO_NAME=corvo-labs-dot-com
BLOG_APP_ROOT=
BLOG_CONTENT_PATH=
BLOG_POST_AUTHOR=Jake Butler
BLOG_DEFAULT_CATEGORY=strategy

# Provider validation keys. Server/worker-side only.
BUFFER_API_KEY=
ZERNIO_API_KEY=
# Firecrawl (AEO/SEO site-crawl + search data vendor). Required for the AEO/SEO
# surface; read-only validateConnection runs against the credit-usage endpoint,
# and crawl/search actions stay gated behind LIVE_PROVIDER_VALIDATION_APPROVED.
FIRECRAWL_API_KEY=
# Per-run cost ceilings for Firecrawl runs (positive integers). Crawl limits
# above FIRECRAWL_MAX_CRAWL_PAGES and search limits above
# FIRECRAWL_MAX_SEARCH_RESULTS are refused before any provider dispatch.
FIRECRAWL_MAX_CRAWL_PAGES=50
FIRECRAWL_MAX_SEARCH_RESULTS=10

# Editorial visuals provider credentials. Read inside Convex "use node" actions, so they
# live on the Convex deployment (`npx convex env set`), not the Next.js host. Keys alone
# qualify nothing: routes require reviewed qualification with capability receipts, spend
# stays under per-provider $5 caps, and admissions stay gated by the rollout flags below.
# scripts/provision-visual-environment.mjs seeds the rest of the environment (budget row,
# seed import, flags) on a dev deployment.
# OpenAI image key — scope Images:Request + Models:Read only.
OPENAI_API_KEY=
# DigitalOcean inference — gpt-image-2 via inference.do-ai.run, generate-only (no reference inputs).
DIGITALOCEAN_INFERENCE_API_KEY=
# Planning + pixel-reflection text/vision calls (openai provider; the cortex provider uses CORTEX_API_KEY above).
OPENAI_TEXT_API_KEY=

# Editorial visuals rollout flags (opt-in). The server flag lives on the Convex deployment
# (`npx convex env set EDITORIAL_VISUALS_ENABLED 1`); the frontend flag is a Next.js
# build-time flag set in .env.local or the host environment. Absence (or any value but 1)
# pauses admissions and hides the visual composer. Flags never qualify a live provider.
EDITORIAL_VISUALS_ENABLED=
NEXT_PUBLIC_EDITORIAL_VISUALS_ENABLED=

# Answer-engine visibility runs (AEO/SEO A3). Cron-driven batches ask each
# connected brand target's question set through the Cortex gateway (falls back
# to OPENAI_API_KEY). Runs execute only when AEO_ANSWER_ENGINE_ENABLED=1 and a
# gateway credential exists; otherwise the batch exits with an explicit
# disabled/credentials-not-configured outcome. All are Convex-deployment env
# vars (npx convex env set), read inside Convex functions.
AEO_ANSWER_ENGINE_ENABLED=0
# Per-run budget (positive integers): the batch refuses a run whose estimated
# cost (questions x AEO_ANSWER_ENGINE_COST_PER_QUESTION_CENTS) exceeds
# AEO_ANSWER_ENGINE_RUN_CEILING_CENTS, and caps the question set at
# AEO_ANSWER_ENGINE_MAX_QUESTIONS.
AEO_ANSWER_ENGINE_MAX_QUESTIONS=6
AEO_ANSWER_ENGINE_RUN_CEILING_CENTS=50
AEO_ANSWER_ENGINE_COST_PER_QUESTION_CENTS=2
# Optional gateway model override for answer-engine questions.
# AEO_ANSWER_ENGINE_MODEL=

# Suggested-competitor discovery (AEO/SEO A5). Cron-driven batches run Firecrawl
# search + gateway questions per connected brand target and record reviewable
# competitorSuggestions rows. Same fail-closed pattern as the answer-engine
# batch: explicit disabled/credentials-not-configured/budget-refused outcomes,
# no silent skips. All are Convex-deployment env vars (npx convex env set).
AEO_DISCOVERY_ENABLED=0
# Live Firecrawl search from the discovery batch requires an explicit approval
# flag, matching the provider-validation gate vocabulary.
AEO_DISCOVERY_LIVE_APPROVED=
# Per-run budget (positive integers): the batch refuses a run whose estimated
# cost (queries x AEO_DISCOVERY_COST_PER_QUERY_CENTS) exceeds
# AEO_DISCOVERY_RUN_CEILING_CENTS, and caps the query set at
# AEO_DISCOVERY_MAX_QUERIES. Search results per query stay capped by
# FIRECRAWL_MAX_SEARCH_RESULTS — no unbounded re-search.
AEO_DISCOVERY_MAX_QUERIES=4
AEO_DISCOVERY_RUN_CEILING_CENTS=50
AEO_DISCOVERY_COST_PER_QUERY_CENTS=2

# Brand -> Buffer LinkedIn channel mapping. Overrides the built-in defaults
# (corvo:corvo-labs-us, lower-db:the-lower-db) when set. IMPORTANT: this is a
# **Convex-deployment** env var (npx convex env set), not Vercel — it is read
# inside Convex functions. Format: comma-separated brand:channel pairs. A set
# list is authoritative: brands absent from it cannot live-submit LinkedIn.
# BUFFER_LINKEDIN_CHANNELS=corvo:corvo-labs-us,lower-db:the-lower-db

# Postiz-style runtime target. Required only when validating the future
# self-hosted Postiz service path.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
FRONTEND_URL=
NEXT_PUBLIC_BACKEND_URL=
BACKEND_INTERNAL_URL=
STORAGE_PROVIDER=
UPLOAD_DIRECTORY=
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=

# Allowlist rollout mode. Set to "log" to evaluate the allowlist and log the
# outcome WITHOUT rejecting requests — use on first deploy to confirm email
# resolution works before enforcing. Any other value (or unset) enforces.
RESONATE_ALLOWLIST_MODE=

# Ops secret for the lab-folder corpus import (CLI -> /api/ops/lab-import).
# Store the same value on the Convex deployment: npx convex env set V2_OPS_SECRET
V2_OPS_SECRET=

# Verification seed (dev Convex only — see docs/verification-seed.md).
# Set on the dev deployment: npx convex env set ALLOW_VERIFICATION_SEED 1
# The seed script authenticates to that deployment with its CONVEX_DEPLOY_KEY.
ALLOW_VERIFICATION_SEED=

# Base URL of the app the corpus-import CLI posts to (defaults to http://localhost:3000).
RESONATE_APP_URL=
